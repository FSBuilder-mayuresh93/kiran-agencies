{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.kiranagencies.in" }],
      "destination": "https://kiranagencies.in/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "kiran-agencies.vercel.app" }],
      "destination": "https://kiranagencies.in/:path*",
      "statusCode": 301
    }
  ]
}
